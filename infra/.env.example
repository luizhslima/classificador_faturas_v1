# Modelo de variáveis para os docker-compose desta pasta. Copie para
# infra/.env (fora do versionamento) no servidor antes de "docker compose up";
# sem ele, o compose recusa subir os serviços.

POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
MINIO_ROOT_USER=<MINIO_ACCESS_KEY>
MINIO_ROOT_PASSWORD=<MINIO_SECRET_KEY>
AIRFLOW__API_AUTH__JWT_SECRET=<AIRFLOW_JWT_SECRET>

# Opcionais
# POSTGRES_DB=n8n
# POSTGRES_USER=n8n
# N8N_DB_PASSWORD=   (padrão: POSTGRES_PASSWORD)

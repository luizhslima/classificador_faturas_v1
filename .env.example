# Modelo de variáveis de ambiente. Copie para .env (fora do versionamento)
# e preencha com os valores reais. Nenhum código do repositório tem valor
# padrão para credenciais: a execução falha se alguma delas faltar.

# PostgreSQL (pgvector) -- experimentos, agente e worker-prata
SYNC_DATABASE_URL=postgresql+psycopg2://n8n:<POSTGRES_PASSWORD>@localhost:5433/agent
DATABASE_URL=postgresql+asyncpg://n8n:<POSTGRES_PASSWORD>@localhost:5433/agent
# O worker-prata usa driver síncrono:
# DATABASE_URL=postgresql+psycopg2://n8n:<POSTGRES_PASSWORD>@localhost:5433/agent

# MinIO (data lakehouse) -- worker-prata, notebooks e service-ingestao
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>

# Artefatos do MLflow no MinIO (mesmo par de chaves do MinIO)
AWS_ACCESS_KEY_ID=<MINIO_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<MINIO_SECRET_KEY>

# Hosts/portas da infraestrutura (padrao: localhost). Defina o IP/host do servidor
# onde rodam Kafka, MinIO, MLflow e Postgres, se nao for a mesma maquina.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT_URL=http://localhost:9000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

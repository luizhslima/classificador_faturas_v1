%%{init: {"themeVariables": {"fontSize": "22px", "fontFamily": "arial"}}}%%
flowchart TD
    %% Cores e Estilos
    classDef client fill:#f8f9fa,stroke:#ced4da,stroke-width:2px,color:#212529
    classDef api fill:#e7f5ff,stroke:#74c0fc,stroke-width:2px,color:#0b7285
    classDef kafka fill:#fff4e6,stroke:#ffa94d,stroke-width:2px,color:#d9480f
    classDef worker fill:#ebfbee,stroke:#8ce99a,stroke-width:2px,color:#2b8a3e
    classDef ia fill:#f3f0ff,stroke:#b197fc,stroke-width:2px,color:#6741d9
    classDef storage fill:#ffe3e3,stroke:#ffa8a8,stroke-width:2px,color:#c92a2a
    classDef silver fill:#e6fcf5,stroke:#63e6be,stroke-width:2px,color:#087f5b
    classDef mlops fill:#fff0f6,stroke:#faa2c1,stroke-width:2px,color:#a61e4d
    classDef analytics fill:#fff3bf,stroke:#fcc419,stroke-width:2px,color:#e67700
    classDef bi fill:#e3fafc,stroke:#3bc9db,stroke-width:2px,color:#0b7285

    %% Atores
    User(["👤 Utilizador\n(Upload da Fatura)"]):::client
    DS(["👩‍🔬 Cientista de Dados\n(Jupyter Notebook)"]):::ia
    
    %% Ingestão
    API["⚙️ API WebFlux\n(Ingestão)"]:::api
    Kafka{"⚡ Apache Kafka\n(Mensageria)"}:::kafka

    %% Workers
    OCR["🔍 Worker OCR\n(Tesseract)"]:::worker
    IA["🧠 Worker IA\n(Modelo ByT5)"]:::ia

    %% Data Lakehouse
    subgraph DataLake["Ecossistema Data Lakehouse (S3 Compatible)"]
        direction TB
        BronzeRAW[("🗂️ MinIO Bronze\n(PDFs Originais)")]:::storage
        BronzeTXT[("📄 MinIO Bronze\n(Textos Sujos)")]:::storage
        Silver[("📊 Iceberg Silver\n(Dados Limpos)")]:::silver
        MinIODVC[("📦 MinIO MLOps\n(Pesos DVC)")]:::mlops
    end

    %% Consumo
    Trino["🔎 Motor SQL\n(Trino / DuckDB)"]:::analytics
    BI["📈 Dashboard BI\n(Metabase)"]:::bi

    %% Fluxos: Ingestão
    User -->|"Upload"| API
    API -->|"Publica Evento"| Kafka
    API -.->|"Guarda PDF"| BronzeRAW

    %% Fluxos: OCR
    Kafka -->|"Consome"| OCR
    OCR -.->|"Lê PDF"| BronzeRAW
    OCR -->|"Grava Texto"| BronzeTXT

    %% Fluxos: MLOps & IA
    DS -->|"dvc push"| MinIODVC
    MinIODVC -.->|"dvc pull (Lê Pesos)"| IA
    Kafka -->|"Consome"| IA
    IA -.->|"Lê Texto Sujo"| BronzeTXT
    IA -->|"Grava Estruturado"| Silver

    %% Fluxos: Analytics
    Trino -.->|"Consulta SQL"| Silver
    Trino -->|"Serve Métricas"| BI